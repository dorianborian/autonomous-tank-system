<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_web_ui</name>
  <version>0.0.1</version>
  <description>Phase 8: FastAPI/WebSocket web control + telemetry UI, Steam Deck as display and controller</description>
  <maintainer email="doriantodd@todo.todo">doriantodd</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>python3-opencv</depend>
  <depend>robot_behavior</depend>
  <depend>tf2_ros</depend>
  <depend>sensor_msgs_py</depend>
  <!-- fastapi/uvicorn/websockets are pip-installed with the system-packages
       override flag, same pattern as ultralytics/torch for the YOLO
       trackers (see odin_yolo_tracker_node.py), rather than declared as
       rosdep keys, since no ROS/apt package provides them on this platform. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
