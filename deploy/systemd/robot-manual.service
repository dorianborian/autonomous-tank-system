[Unit]
Description=Robot manual-mode teleop (serial_driver, joy_node, ps_controller_bridge, drive_mux, mode_manager, safety_watchdog)
After=multi-user.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=YOUR_USERNAME
Environment=HOME=/home/YOUR_USERNAME
ExecStart=/home/YOUR_USERNAME/autonomous-tank-system/deploy/scripts/start_manual_mode.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
